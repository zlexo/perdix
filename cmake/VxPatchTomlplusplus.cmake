# Runs in toml++'s source directory at every configure: backports upstream
# fixes, and one of Perdix's own, for short malformed files that toml++ 3.4.0
# cannot parse safely. A debug build stopped on one of toml++'s assertions,
# with no message naming the block file, and a release build ran into code
# its optimizer assumes unreachable. Safe to run again, and it writes only
# what changes, so nothing rebuilds for it.
#
# backport(<file> <source> <faulty> <fixed>) replaces the faulty code with the
# fix, unless the fix is already in. A toml++ with neither stops the
# configure, so whoever bumps the version decides whether it still applies.
function(backport file source faulty fixed)
    file(READ "${file}" text)
    string(FIND "${text}" "${fixed}" fixed_at)
    if(NOT fixed_at EQUAL -1)
        return()
    endif()
    string(FIND "${text}" "${faulty}" faulty_at)
    if(faulty_at EQUAL -1)
        message(FATAL_ERROR "${file} has neither the code ${source} fixes nor its fix: check "
            "whether cmake/VxPatchTomlplusplus.cmake still applies to this toml++.")
    endif()
    string(REPLACE "${faulty}" "${fixed}" text "${text}")
    file(WRITE "${file}" "${text}")
endfunction()

# marzer/tomlplusplus e4bcc150 (#301), after 3.4.0: a table header whose
# name starts with neither a key character nor a quote, such as "[" ending
# its line, reached parse_key, which asserts it never sees one.
backport(include/toml++/impl/parser.inl "marzer/tomlplusplus e4bcc150"
[==[
				if (*cp == U']')
					set_error_and_return_default("tables with blank bare keys are explicitly prohibited"sv);

				// get the actual key
				start_recording();
				parse_key();]==]
[==[
				if (*cp == U']')
					set_error_and_return_default("tables with blank bare keys are explicitly prohibited"sv);

				if (!is_bare_key_character(*cp) && !is_string_delimiter(*cp))
					set_error_and_return_default("expected bare key starting character or string delimiter, saw '"sv,
												 to_sv(*cp),
												 "'"sv);

				// get the actual key
				start_recording();
				parse_key();]==])

# marzer/tomlplusplus 1e8829b7 (#305), after 3.4.0: a character in a part of
# Unicode with no whitespace, such as the degree sign in "90°", fell to a
# TOML_UNREACHABLE where it should have been "not whitespace".
backport(include/toml++/impl/unicode_autogenerated.hpp "marzer/tomlplusplus 1e8829b7"
[==[
			case 0x05: return c == U'\u1680' || c == U'\u180E';
			case 0x07:
				return (U'\u2000' <= c && c <= U'\u200B') || (U'\u205F' <= c && c <= U'\u2060') || c == U'\u202F';
			default: TOML_UNREACHABLE;
		}

		TOML_UNREACHABLE;
	}

	TOML_CONST_GETTER]==]
[==[
			case 0x05: return c == U'\u1680' || c == U'\u180E';
			case 0x07:
				return (U'\u2000' <= c && c <= U'\u200B') || (U'\u205F' <= c && c <= U'\u2060') || c == U'\u202F';
			default: return false;
		}
	}

	TOML_CONST_GETTER]==])

# marzer/tomlplusplus c4369ae1 (#242), after 3.4.0: a dotted key of thousands
# of parts nests a table for each and overflows the stack. Upstream limits
# the depth to 1,024 through a new macro; the limit is written in place here.
backport(include/toml++/impl/parser.inl "marzer/tomlplusplus c4369ae1"
[==[
				// store segment
				key_buffer.push_back(key_segment, key_begin, key_end);

				// eof or no more key to come]==]
[==[
				// store segment
				key_buffer.push_back(key_segment, key_begin, key_end);

				if TOML_UNLIKELY(key_buffer.size() > 1024)
					set_error_and_return_default("exceeded maximum dotted keys depth of 1024"sv);

				// eof or no more key to come]==])

# Perdix's own, found by fuzzing and still in upstream's master: an array
# whose next value starts with a closing brace, as in ["y", "x", }, reached
# parse_value, which asserts it never sees a value terminator.
backport(include/toml++/impl/parser.inl "a value starting with a value terminator"
[==[
				prev = parse_type::val;

				auto val = parse_value();]==]
[==[
				prev = parse_type::val;

				if (is_value_terminator(*cp))
					set_error_and_return_default("expected value, saw '"sv, to_sv(*cp), "'"sv);
				auto val = parse_value();]==])
